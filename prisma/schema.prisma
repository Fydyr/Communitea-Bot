generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnecdoteChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  roleId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

model SentAnecdote {
  id        String   @id @default(cuid())
  guildId   String
  title     String
  sentAt    DateTime @default(now())

  @@index([title])
  @@index([guildId])
}

model SentQuiz {
  id        String   @id @default(cuid())
  guildId   String
  question  String
  sentAt    DateTime @default(now())

  @@index([guildId])
}

model GuildSettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  hours     Int[]    @default([8, 20])
  timezone  String   @default("Europe/Paris")
  language  String   @default("fr")
  themes    String[] @default([])
  quizHours Int[]    @default([])
  newsHours Int[]    @default([])
  updatedAt DateTime @updatedAt
}

model AnecdoteMessage {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String   @unique
  title     String
  language  String
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  sentAt    DateTime @default(now())

  @@index([guildId])
}

model AnecdoteVote {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model UserStats {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  xp           Int      @default(0)
  level        Int      @default(0)
  quizAnswered Int      @default(0)
  quizCorrect  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
}

model XpEvent {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  source    String
  refId     String
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, source, refId])
}

model NewsChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  roleId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

model SentNews {
  id      String   @id @default(cuid())
  guildId String
  url     String
  title   String
  sentAt  DateTime @default(now())

  @@index([guildId, sentAt])
}

model NewsRun {
  id            String    @id @default(cuid())
  guildId       String
  runDate       String
  slotHour      Int
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, runDate, slotHour])
  @@index([status, nextAttemptAt])
}
